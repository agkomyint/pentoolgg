{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentool.space/schema/layout-v1.json",
  "title": "Pentool page layout object (format v9, developing contract)",
  "description": "The layout object of a v9 document plus the text-frame and graphic-frame scene nodes. See docs/layout-v1.md. Cross-reference integrity (threads, style chains, parents, sections) and the numeric limits are additionally enforced by Rust.",
  "type": "object",
  "required": ["engine"],
  "properties": {
    "engine": {"type": "integer", "minimum": 1},
    "page_defaults": {"$ref": "#/$defs/pageGeometry"},
    "spreads": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/spread"}},
    "parents": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/parent"}},
    "sections": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/section"}},
    "stories": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/story"}},
    "styles": {"$ref": "#/$defs/styles"},
    "lists": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "notes": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/note"}},
    "note_settings": {"$ref": "#/$defs/noteSettings"},
    "conditions": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/condition"}},
    "condition_sets": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/conditionSet"}},
    "active_condition_set": {"$ref": "#/$defs/id"},
    "variables": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/variable"}},
    "xrefs": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/xref"}},
    "hyperlinks": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/hyperlink"}},
    "bookmarks": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/bookmark"}},
    "index_topics": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/indexTopic"}},
    "generated_at": {"$ref": "#/$defs/date"},
    "created_at": {"$ref": "#/$defs/date"},
    "modified_at": {"$ref": "#/$defs/date"},
    "output_at": {"$ref": "#/$defs/date"},
    "generated": {"type": "array", "items": {"$ref": "#/$defs/generated"}},
    "guides": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "baseline_grid": {"$ref": "#/$defs/baselineGrid"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f/\\\\]+$"},
    "idObject": {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}},
    "length": {"type": "number", "minimum": -1000000, "maximum": 1000000},
    "extent": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
    "insets": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1000000}},
    "pageGeometry": {
      "type": "object",
      "properties": {
        "margins": {"$ref": "#/$defs/insets"},
        "columns": {"type": "integer", "minimum": 1, "maximum": 40},
        "gutter": {"type": "number", "minimum": 0, "maximum": 100000}
      }
    },
    "spread": {
      "type": "object",
      "required": ["id", "pages"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "pages": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/id"}},
        "facing": {"type": "boolean"}
      }
    },
    "parent": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "based_on": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "name": {"type": "string", "maxLength": 256},
        "pages": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/id"}},
        "margins": {"$ref": "#/$defs/insets"},
        "columns": {"type": "integer", "minimum": 1, "maximum": 40},
        "gutter": {"type": "number", "minimum": 0, "maximum": 100000}
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "start_page"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "start_page": {"$ref": "#/$defs/id"},
        "start_number": {"type": "integer", "minimum": 1, "maximum": 100000},
        "style": {"enum": ["arabic", "upper-roman", "lower-roman", "upper-alpha", "lower-alpha"]},
        "prefix": {"type": "string", "maxLength": 16, "pattern": "^[\\u0020-\\u007e]*$"},
        "continue": {"type": "boolean"}
      }
    },
    "story": {
      "type": "object",
      "required": ["id", "paragraphs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "language": {"type": "string", "maxLength": 35},
        "paragraphs": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/paragraph"}}
      }
    },
    "paragraph": {
      "type": "object",
      "required": ["runs"],
      "properties": {
        "style": {"$ref": "#/$defs/id"},
        "overrides": {"type": "object"},
        "runs": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/run"}}
      }
    },
    "run": {
      "type": "object",
      "oneOf": [
        {"required": ["text"], "properties": {"text": {"type": "string", "maxLength": 16777216}, "style": {"$ref": "#/$defs/id"}, "overrides": {"type": "object"}}},
        {"required": ["anchor"], "properties": {"anchor": {"$ref": "#/$defs/id"}}},
        {"required": ["note"], "properties": {"note": {"$ref": "#/$defs/id"}}},
        {"required": ["variable"], "properties": {"variable": {"$ref": "#/$defs/id"}}},
        {"required": ["xref"], "properties": {"xref": {"$ref": "#/$defs/id"}}},
        {"required": ["index"], "properties": {"index": {"$ref": "#/$defs/id"}}},
        {"required": ["table"], "properties": {"table": {"$ref": "#/$defs/id"}}},
        {"required": ["special"], "properties": {"special": {"enum": ["tab", "line-break", "column-break", "frame-break", "page-break", "em-space", "en-space", "thin-space", "hair-space", "flush-space", "right-indent-tab", "section-marker", "page-number", "next-page-number", "previous-page-number", "discretionary-hyphen", "nonbreaking-hyphen"]}}},
        {"required": ["condition"], "properties": {"condition": {"$ref": "#/$defs/id"}, "runs": {"type": "array", "items": {"type": "object"}}}},
        {"required": ["link", "runs"], "properties": {"link": {"$ref": "#/$defs/id"}, "runs": {"type": "array", "items": {"type": "object"}}}}
      ]
    },
    "styles": {
      "type": "object",
      "properties": {
        "paragraph": {"$ref": "#/$defs/styleMap"},
        "character": {"$ref": "#/$defs/styleMap"},
        "object": {"$ref": "#/$defs/styleMap"},
        "table": {"$ref": "#/$defs/styleMap"},
        "cell": {"$ref": "#/$defs/styleMap"}
      },
      "additionalProperties": false
    },
    "styleMap": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "based_on": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
          "next": {"$ref": "#/$defs/id"},
          "group": {"type": "string", "maxLength": 256},
          "font": {"type": "string", "maxLength": 256},
          "size": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
          "leading": {"anyOf": [{"const": "auto"}, {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}]},
          "align": {"enum": ["left", "center", "right", "justify", "justify-last-left", "justify-last-center", "justify-last-right", "justify-last-all", "towards-spine", "away-from-spine"]},
          "hyphenate": {"type": "boolean"},
          "composer": {"enum": ["single-line", "paragraph"]},
          "align_to_grid": {"enum": ["none", "first-line", "all-lines"]},
          "language": {"type": "string", "maxLength": 35}
        }
      }
    },
    "baselineGrid": {
      "type": "object",
      "required": ["increment"],
      "properties": {
        "start": {"type": "number", "minimum": 0, "maximum": 1000000},
        "increment": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "relative_to": {"enum": ["page", "margin"]}
      }
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z?)?$"},
    "note": {
      "type": "object",
      "required": ["id", "kind", "paragraphs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["footnote", "endnote"]},
        "span_columns": {"type": "boolean"},
        "paragraphs": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["runs"], "properties": {"runs": {"type": "array", "items": {"type": "object"}}}}
        }
      }
    },
    "noteSettings": {
      "type": "object",
      "properties": {
        "restart": {"enum": ["document", "story", "section", "page"]},
        "style": {"enum": ["arabic", "lower-roman", "upper-roman", "lower-alpha", "upper-alpha"]}
      }
    },
    "condition": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "visible": {"type": "boolean"}}
    },
    "conditionSet": {
      "type": "object", "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "show": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "hide": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "variable": {
      "type": "object", "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["chapter-number", "running-header", "creation-date", "modification-date", "output-date", "file-name", "last-page-number", "custom"]},
        "style": {"$ref": "#/$defs/id"},
        "pick": {"enum": ["first", "last"]},
        "value": {"type": "string", "maxLength": 65536},
        "format": {"type": "string", "maxLength": 64}
      }
    },
    "target": {
      "type": "object",
      "oneOf": [
        {"required": ["story", "paragraph"], "properties": {"story": {"$ref": "#/$defs/id"}, "paragraph": {"type": "integer", "minimum": 0}}},
        {"required": ["page"], "properties": {"page": {"$ref": "#/$defs/id"}}},
        {"required": ["bookmark"], "properties": {"bookmark": {"$ref": "#/$defs/id"}}}
      ]
    },
    "xref": {
      "type": "object", "required": ["id", "target", "format"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/target"},
        "format": {"enum": ["page", "paragraph-text", "paragraph-number", "chapter", "custom"]},
        "template": {"type": "string", "maxLength": 256}
      }
    },
    "hyperlink": {
      "type": "object", "required": ["id"],
      "oneOf": [
        {"required": ["url"], "properties": {"url": {"type": "string", "maxLength": 2048, "pattern": "^([Hh][Tt][Tt][Pp][Ss]?|[Mm][Aa][Ii][Ll][Tt][Oo]):[^ ]+$"}}},
        {"required": ["page"], "properties": {"page": {"$ref": "#/$defs/id"}}},
        {"required": ["bookmark"], "properties": {"bookmark": {"$ref": "#/$defs/id"}}}
      ],
      "properties": {"id": {"$ref": "#/$defs/id"}}
    },
    "bookmark": {
      "type": "object", "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "maxLength": 256},
        "story": {"$ref": "#/$defs/id"},
        "paragraph": {"type": "integer", "minimum": 0},
        "page": {"$ref": "#/$defs/id"}
      }
    },
    "indexTopic": {
      "type": "object", "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1},
        "sort": {"type": "string"},
        "see": {"$ref": "#/$defs/id"}
      }
    },
    "generated": {
      "type": "object",
      "required": ["id", "kind", "story"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["toc", "index", "captions", "list-of-figures", "endnotes"]},
        "story": {"$ref": "#/$defs/id"},
        "inputs": {"type": "array", "items": {"type": "string", "maxLength": 128}},
        "options": {
          "type": "object",
          "properties": {
            "styles": {"type": "array", "items": {"$ref": "#/$defs/id"}},
            "style": {"$ref": "#/$defs/id"},
            "label": {"type": "string", "maxLength": 128},
            "source": {"enum": ["paragraphs", "metadata", "both"]},
            "page_range": {"enum": ["first", "contiguous", "all"]},
            "language": {"type": "string", "maxLength": 35}
          }
        },
        "entries": {"type": "integer", "minimum": 0},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stale": {"type": "boolean"}
      }
    },
    "textFrame": {
      "type": "object",
      "required": ["kind", "id", "story"],
      "properties": {
        "kind": {"const": "text-frame"},
        "id": {"$ref": "#/$defs/id"},
        "story": {"$ref": "#/$defs/id"},
        "next": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "x": {"$ref": "#/$defs/length"},
        "y": {"$ref": "#/$defs/length"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "columns": {"type": "integer", "minimum": 1, "maximum": 40},
        "gutter": {"type": "number", "minimum": 0, "maximum": 100000},
        "inset": {"$ref": "#/$defs/insets"},
        "vertical_align": {"enum": ["top", "center", "bottom", "justify"]},
        "first_baseline": {"enum": ["ascent", "cap-height", "leading", "x-height", "fixed"]},
        "auto_size": {"enum": ["off", "height", "width", "both"]},
        "ignore_wrap": {"type": "boolean"},
        "primary": {"type": "boolean"}
      }
    },
    "graphicFrame": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "graphic-frame"},
        "id": {"$ref": "#/$defs/id"},
        "x": {"$ref": "#/$defs/length"},
        "y": {"$ref": "#/$defs/length"},
        "width": {"$ref": "#/$defs/extent"},
        "height": {"$ref": "#/$defs/extent"},
        "content": {"$ref": "#/$defs/id"},
        "fit": {"enum": ["fill", "fit", "fit-content-to-frame", "fit-frame-to-content", "center", "proportional"]}
      }
    }
  }
}
