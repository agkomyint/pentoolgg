{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentool.space/schema/pen-v9.json",
  "title": "Pentool document v9 (page layout, developing contract)",
  "description": "Developing v9 envelope: all v8 content plus the optional layout object (docs/layout-v1.md). Page and node content is validated by the v4-v8 schemas and by Rust; this schema pins the version, the layout extension and the frame nodes. Unknown fields are preserved.",
  "type": "object",
  "required": ["format", "version", "name", "pages"],
  "properties": {
    "format": {"const": "pentool"},
    "version": {"const": 9},
    "name": {"type": "string"},
    "pages": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/page"}},
    "layout": {"$ref": "https://pentool.space/schema/layout-v1.json"}
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "canvas", "layers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "canvas": {"type": "object", "required": ["width", "height"]},
        "layout": {
          "type": "object",
          "properties": {
            "parent": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
            "margins": {"$ref": "https://pentool.space/schema/layout-v1.json#/$defs/insets"},
            "columns": {"type": "integer", "minimum": 1, "maximum": 40},
            "gutter": {"type": "number", "minimum": 0}
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nodes"],
            "properties": {"nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}}
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["kind", "id"],
      "allOf": [
        {"if": {"properties": {"kind": {"const": "text-frame"}}, "required": ["kind"]}, "then": {"$ref": "https://pentool.space/schema/layout-v1.json#/$defs/textFrame"}},
        {"if": {"properties": {"kind": {"const": "graphic-frame"}}, "required": ["kind"]}, "then": {"$ref": "https://pentool.space/schema/layout-v1.json#/$defs/graphicFrame"}}
      ]
    }
  }
}
