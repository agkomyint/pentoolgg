    "x": 40,
    "y": 70,
    "font_family": "sans-serif",
    "font_size": 24,
    "fill": "#ffffff"
  },
  {
    "type": "create-group",
    "id": "batch-card",
    "layer": "content",
    "children": ["$background", "$title"]
