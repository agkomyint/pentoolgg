      "required": [
        "space",
        "channels",
        "profile"
      ],
      "properties": {
        "space": {
          "enum": [
            "icc-rgb"
          ]
        },
        "channels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "profile": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(profile:)?([A-Za-z0-9][A-Za-z0-9._-]{0,63}|sha256:[0-9a-f]{64})$"
        }
      },
      "additionalProperties": false
    },
    {
