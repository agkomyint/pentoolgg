{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentool.space/schema/pen-v4.json",
  "title": "Pentool document v4",
  "type": "object",
  "required": ["format", "version", "name", "pages"],
  "properties": {
    "format": {"const": "pentool"}, "version": {"const": 4}, "name": {"type": "string"},
    "fonts": {"type": "array"}, "styles": {"type": "object"}, "components": {"type": "array"},
    "pages": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/page"}}
  },
  "additionalProperties": true,
  "$defs": {
    "matrix": {"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}],"items":false},
    "styleValue": {"type":"object","required":["fallback"],"properties":{"ref":{"type":"string"},"fallback":{}},"additionalProperties":true},
    "style": {"type":"object","additionalProperties":{"$ref":"#/$defs/styleValue"}},
    "base": {"type":"object","required":["kind","id"],"properties":{"kind":{"type":"string"},"id":{"type":"string","minLength":1},"transform":{"$ref":"#/$defs/matrix"},"clip":{"type":"string"},"style":{"$ref":"#/$defs/style"}},"additionalProperties":true},
    "node": {"oneOf":[
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"group"},"children":{"type":"array","items":{"$ref":"#/$defs/node"}}},"required":["children"]}]},
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"rect"},"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number","minimum":0},"height":{"type":"number","minimum":0},"radius_x":{"type":"number","minimum":0},"radius_y":{"type":"number","minimum":0}},"required":["x","y","width","height"]}]},
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"ellipse"},"cx":{"type":"number"},"cy":{"type":"number"},"radius_x":{"type":"number","exclusiveMinimum":0},"radius_y":{"type":"number","exclusiveMinimum":0}},"required":["cx","cy","radius_x","radius_y"]}]},
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"line"},"x1":{"type":"number"},"y1":{"type":"number"},"x2":{"type":"number"},"y2":{"type":"number"}},"required":["x1","y1","x2","y2"]}]},
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"path"},"d":{"type":"string"}},"required":["d"]}]},
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"text"},"content":{"type":"string"},"x":{"type":"number"},"y":{"type":"number"}},"required":["content","x","y"]}]},
      {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"instance"},"component":{"type":"string"},"fallback":{"$ref":"#/$defs/node"},"overrides":{"type":"object"}},"required":["component","fallback"]}]}
    ]},
    "layer": {"type":"object","required":["id","name","nodes"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string"},"visible":{"type":"boolean"},"locked":{"type":"boolean"},"nodes":{"type":"array","items":{"$ref":"#/$defs/node"}}},"additionalProperties":true},
    "page": {"type":"object","required":["id","name","canvas","layers"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string"},"canvas":{"type":"object","required":["width","height","background"],"properties":{"width":{"type":"integer","minimum":1,"maximum":16384},"height":{"type":"integer","minimum":1,"maximum":16384},"background":{"type":"string"}},"additionalProperties":true},"layers":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/layer"}}},"additionalProperties":true}
  }
}
