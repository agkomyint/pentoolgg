{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentool.space/schema/penbook-v1.json",
  "title": "Pentool book manifest (.penbook) version 1, developing contract",
  "description": "Readable JSON listing member .pen documents. Member paths are relative to the book file and must stay inside its directory; Rust additionally resolves symlinks and rejects escapes.",
  "type": "object",
  "required": ["format", "version", "name", "documents"],
  "properties": {
    "format": {"const": "penbook"},
    "version": {"const": 1},
    "name": {"type": "string", "maxLength": 256},
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^\\u0000]+\\.pen$"},
          "role": {"enum": ["front", "chapter", "back", "appendix", "index"]}
        }
      }
    },
    "numbering": {
      "type": "object",
      "properties": {
        "page": {"enum": ["continuous", "restart-each"]},
        "chapter": {"enum": ["continuous", "restart-each", "none"]},
        "footnote": {"enum": ["per-document", "continuous"]}
      }
    },
    "synchronize": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "styles": {"type": "boolean"},
        "swatches": {"type": "boolean"},
        "parents": {"type": "boolean"}
      }
    }
  }
}
