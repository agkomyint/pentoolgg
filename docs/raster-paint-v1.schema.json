{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentool.dev/schema/raster-paint-v1.json",
  "title": "Pentool raster-paint node (v6, engine 1)",
  "type": "object",
  "required": ["kind", "id", "x", "y", "width", "height", "tile_size", "pixel_format", "tiles"],
  "properties": {
    "kind": { "const": "raster" },
    "id": { "type": "string", "minLength": 1 },
    "engine": {
      "type": "integer", "minimum": 1, "default": 1,
      "description": "Raster engine that last wrote the node. Readers render any value from the materialized tiles; writers refuse to mutate or replay a node whose engine exceeds their own."
    },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "tile_size": { "const": 256 },
    "pixel_format": { "const": "rgba8-straight" },
    "tiles": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": { "pattern": "^(0|[1-9][0-9]{0,4}),(0|[1-9][0-9]{0,4})$" },
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "journal": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/stroke" } },
    "checkpoint": {
      "type": "object",
      "description": "Replay base: replaying journal[journal_offset..] from tiles reproduces the live tile map.",
      "properties": {
        "engine": { "type": "integer", "minimum": 1 },
        "tiles": { "$ref": "#/properties/tiles" },
        "tile_map_sha256": { "type": "string" },
        "journal_offset": { "type": "integer", "minimum": 0, "maximum": 256 },
        "journal_dropped": { "type": "integer", "minimum": 0 },
        "repaired_lost_tiles": {
          "type": "array", "items": { "type": "string" },
          "description": "Tile keys dropped to transparency by `raster repair --strategy transparent`."
        }
      }
    }
  },
  "$defs": {
    "dynamic": {
      "type": "object",
      "required": ["input", "curve", "fallback"],
      "additionalProperties": false,
      "description": "Journal form; curve and fallback are always written. size/flow/roundness outputs are 0-1 multipliers, angle outputs are -360..360 degrees added to the brush angle.",
      "properties": {
        "input": { "enum": ["pressure", "tilt", "azimuth", "twist", "velocity"] },
        "curve": {
          "type": "array", "minItems": 2, "maxItems": 16,
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
        },
        "fallback": { "type": "number", "minimum": 0 }
      }
    },
    "stroke": {
      "type": "object",
      "required": ["id", "engine", "brush", "samples", "color", "blend", "seed"],
      "properties": {
        "op": { "const": "stroke", "default": "stroke" },
        "engine": { "type": "integer", "minimum": 1 },
        "blend": { "enum": ["normal", "erase", "background-erase", "smudge", "blur", "sharpen", "dodge", "burn", "sponge", "color-replace", "clone", "heal"] },
        "selection": {
          "type": "object",
          "required": ["width", "height", "tiles"],
          "description": "The pinned selection coverage this stroke was limited by.",
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "tiles": { "type": "object", "maxProperties": 256 }
          }
        },
        "heal": {
          "type": "object",
          "required": ["algorithm"],
          "additionalProperties": false,
          "description": "Only with blend heal: the heal algorithm version (1).",
          "properties": { "algorithm": { "const": 1 } }
        },
        "clone": {
          "type": "object",
          "required": ["source", "sx", "sy", "ax", "ay", "angle", "scale"],
          "additionalProperties": false,
          "description": "Only with blends clone and heal. Destination pixel p reads the source at S + R(-angle)(p - A)/scale.",
          "properties": {
            "source": {
              "oneOf": [
                { "const": "current", "description": "The target layer before the stroke." },
                {
                  "type": "object",
                  "required": ["layer", "width", "height", "tiles"],
                  "additionalProperties": false,
                  "properties": {
                    "layer": { "type": "string", "minLength": 1 },
                    "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
                    "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
                    "tiles": { "$ref": "#/properties/tiles", "maxProperties": 256 }
                  }
                }
              ]
            },
            "sx": { "type": "number" },
            "sy": { "type": "number" },
            "ax": { "type": "number" },
            "ay": { "type": "number" },
            "angle": { "type": "number", "minimum": -360, "maximum": 360 },
            "scale": { "type": "number", "minimum": 0.1, "maximum": 10 }
          }
        },
        "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
        "seed": { "type": "integer", "minimum": 0 },
        "samples": {
          "type": "array", "minItems": 1, "maxItems": 8192,
          "description": "Canonical samples: every optional channel is present on all samples or none. Timestamps are never journaled.",
          "items": {
            "oneOf": [
              { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
              {
                "type": "object",
                "required": ["x", "y", "pressure"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
                  "tilt": { "type": "number", "minimum": 0, "maximum": 90 },
                  "azimuth": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
                  "twist": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
                  "velocity": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            ]
          }
        },
        "brush": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["hard-round", "soft-round", "pixel", "calligraphic", "textured"] },
            "smoothing": { "type": "number", "minimum": 0, "maximum": 0.95, "default": 0 },
            "buildup": { "type": "boolean", "default": true },
            "tip": {
              "type": "string", "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "Journals record the tip digest; required for and only valid with kind textured."
            },
            "strength": { "type": "number", "minimum": 0, "maximum": 1, "description": "Smudge, blur, sharpen, dodge, burn and sponge only." },
            "tolerance": { "type": "integer", "minimum": 0, "maximum": 255, "description": "Background-erase and color-replace only." },
            "range": { "enum": ["shadows", "midtones", "highlights"], "description": "Dodge and burn only." },
            "mode": { "enum": ["saturate", "desaturate"], "description": "Sponge only." },
            "texture": { "type": "number", "minimum": 0, "maximum": 1, "description": "Heal only: share of source detail (default 1)." },
            "tone": { "type": "number", "minimum": 0, "maximum": 1, "description": "Heal only: share of destination tone correction (default 1)." },
            "dynamics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": { "$ref": "#/$defs/dynamic" },
                "flow": { "$ref": "#/$defs/dynamic" },
                "roundness": { "$ref": "#/$defs/dynamic" },
                "angle": { "$ref": "#/$defs/dynamic" }
              }
            }
          }
        }
      }
    }
  },
  "x-document": {
    "raster_tiles": "top-level object: digest -> {encoding: 'png-base64', data}. Digest is the sha256 of the 256*256*4 straight-RGBA bytes.",
    "raster_selections": "top-level object: {active: {<layer id>: {width, height, tiles: {\"tx,ty\": digest}}}, saved: {<layer id>: {<name matching ^[A-Za-z0-9._-]{1,64}$, at most 32 per layer>: {width, height, tiles}}}}. Tiles are straight-RGBA with alpha = coverage 0-255; a missing tile is 0. Stroke journal entries pin the active selection in their `selection` property.",
    "brush_presets": "top-level object (at most 256): name matching ^[A-Za-z0-9._-]{1,64}$ -> {engine: raster engine required (>= 1, not above the build), brush: an object limited to the brush properties, description?: plain text up to 280 characters}. Strokes record the resolved brush and, when used, its preset name.",
    "brush_tips": "top-level object (at most 256): name matching ^[A-Za-z0-9._-]{1,64}$ -> sha256 digest of a raster_tiles entry whose alpha channel is the tip coverage."
  }
}
