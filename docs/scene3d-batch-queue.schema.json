{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentool.design/schemas/scene3d-batch-queue-v1.schema.json",
  "title": "Pentool Scene3D Batch Queue v1",
  "type": "object",
  "required": ["format", "jobs"],
  "properties": {
    "format": { "const": "pentool-scene3d-batch-queue-v1" },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["document", "nodes"],
        "properties": {
          "document": { "type": "string", "minLength": 1 },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
